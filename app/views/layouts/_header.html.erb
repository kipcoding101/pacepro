    <%= link_to image_tag("logogram.png", :alt => "logo", :class => "max-w-[50px]"), root_path, class: '' %>
  </div>
  <div class="flex-1 text-center">
    <ul class="menu-horizontal gap-8 text-slate-50/50 px-1 uppercase">
