<header class="navbar fixed opacity-100">
  <div class="flex logo p-2">
    <%= link_to image_tag("logogram.png", :alt => "logo", :class => "max-w-[50px]"), root_path %>
  </div>
  <div class="flex-1 text-right">
    <ul class="menu-horizontal gap-8 text-slate-50/80 px-1 uppercase text-shadow-md bg-slate-900/40 p-3 px-5 rounded-full">
      <li class="flex gap-4 hover:text-slate-50 duration-300 ease-in-out btn-navbar">
        <%= link_to root_path, class: "flex gap-3" do %>
          <%= image_tag("logo-mono.png", alt: "Icon", width: 25) %>
        <% end %>
      </li>
      <li><%= link_to 'Events', events_path, class: 'btn-navbar' %></li>
      <li><%= link_to 'Services', services_path, class: 'hover:text-slate-50 duration-300 ease-in-out' %></li>
      <li><%= link_to 'About', about_path, class: 'hover:text-slate-50 duration-300 ease-in-out btn-navbar' %></li>
    </ul>
  </div>
</header>