<div class="page-header flex flex-col min-h-64 justify-center items-center bg-cover bg-[url(hero1.webp)] bg-center pt-4">
  <div class="container">
      <div class="p-8">
      <h2 class="flex m-0 text-4xl text-white font-bold text-shadow-lg">Events</h2>
      <p class="text-slate-50 mt-2">
        Discover upcoming and past events. Browse our calendar of races, tours, and meet-ups.
      </p>
    </div>
  </div>
</div>
<div class="container mx-auto">
  <section class="relative">
    <div class="max-w-4xl mx-auto text-center mt-6 px-4">

    </div>
  </section>
  <% { "Upcoming" => @upcoming_events, "Live Today" => @live_events, "Past" => @past_events }.each do |section, events| %>
      <% next if events.blank? %>
      <h2 class="text-2xl font-semibold mt-8 mb-4"><%= section %></h2>
      <div class="overflow-x-auto py-4 px-4">
        <div class="inline-flex space-x-6">
          <%= render partial: "pages/events/card", collection: events, as: :event %>
        </div>
      </div>
    <% end %>
  </div>


    
