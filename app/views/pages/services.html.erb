<div class="page-header flex flex-col min-h-64 justify-center items-center bg-cover bg-[url(hero1.webp)] bg-center pt-4">
  <div class="container">
      <div class="p-8">
      <h2 class="flex m-0 text-4xl text-white font-bold text-shadow-lg">Services</h2>
      <p class="text-slate-50 mt-2">
      </p>
    </div>
  </div>
</div>
<div class="container mx-auto px-4 py-8">
  <h1 class="text-4xl font-bold mb-8">Our Services</h1>
  
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <% ['Event Organization', 'Timing Systems', 'Route Planning'].each do |service| %>
      <div class="card bg-base-100 shadow">
        <div class="card-body">
          <h2 class="card-title"><%= service %></h2>
          <p>Description of <%= service.downcase %> service...</p>
        </div>
      </div>
    <% end %>
  </div>
</div>