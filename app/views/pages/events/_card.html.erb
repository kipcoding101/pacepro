<%= link_to event_path(event), class: "block" do %>
  <div class="card card-compact w-64 bg-base-100 shadow-lg hover:shadow-2xl transition-shadow duration-200">
    <% if event.cover_image.attached? %>
      <figure class="h-40 overflow-hidden">
        <%= image_tag event.cover_image.variant(resize_to_limit: [256,160]),
                      class: "object-cover w-full h-full" %>
      </figure>
    <% end %>
    <div class="card-body p-4">
      <h2 class="card-title text-lg"><%= event.title %></h2>
      <div class="text-sm text-gray-500 mt-1">
        <span class="inline-flex items-center">
          <!-- calendar icon -->
           <%= event.start_date.strftime("%-d %b %Y") %>
        </span>
        <br/>
        <span class="inline-flex items-center mt-1">
          <!-- location icon -->
          <%= event.location %>
        </span>
      </div>
    </div>
  </div>
<% end %>
