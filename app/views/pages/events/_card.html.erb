<%= link_to event_path(event), class: "flex w-full max-w-3/4" do %>
  <div class="block-schedule flex w-full bg-gray-600 rounded-sm overflow-hidden">
    <div class="block-schedule-date flex flex-col p-4 justify-center items-center text-center">
      <span class="text-5xl font-light">
        <%= event.start_date.strftime("%-d") %>
      </span>
      <div class="flex whitespace-nowrap opacity-70">
        <%= event.start_date.strftime("%b") %>
        <%= event.start_date.strftime("%Y") %>
      </div>
    </div>

    <div class="block-schedule-content flex w-full bg-gray-700 items-center p-4">
      <h2 class="card-title text-lg"><%= event.title %></h2>
    </div>

    <div class="block-schedule-location flex px-4 bg-gray-600 justify-center items-center">
      <!-- location icon -->
      <%= event.location %>
    </div>
  </div>
<% end %>
<%
=begin
%>

<% if event.cover_image.attached? %>
  <figure class="h-40 overflow-hidden">
    <%= image_tag event.cover_image.variant(resize_to_limit: [256,160]),
                  class: "object-cover w-full h-full" %>
  </figure>
<% else %>
  <figure class="h-40 overflow-hidden">
    <%= image_tag "hero1.webp", class: "object-cover w-full h-full" %>
  </figure>
<% end %>
<%
=end
 %>